{
  "name": "chimera",
  "private": true,
  "version": "0.28.2",
  "type": "module",
  "scripts": {
    "dev": "run-p -r  web:devtools tauri:dev",
    "tauri:dev": "tauri dev -c ./backend/tauri/tauri.conf.json",
    "web:devtools": "pnpm react-devtools",
    "web:dev": "pnpm --filter=chimera-ui dev",
    "build": "tauri build",
    "build:nightly": "tauri build -f nightly -c ./backend/tauri/tauri.nightly.conf.json",
    "web:build": "pnpm --filter=chimera-ui build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --ignore-pattern \"ref/**\"",
    "lint:prettier": "prettier --check .",
    "lint:styles": "stylelint --cache --allow-empty-input \"**/*.{css,scss}\"",
    "lint:clippy": "cargo clippy --manifest-path ./backend/Cargo.toml --all-targets --all-features",
    "typecheck": "run-p typecheck:*",
    "typecheck:interface": "tsc -p frontend/interface/tsconfig.json --noEmit",
    "typecheck:ci": "tsc --noEmit -p scripts/tsconfig.ci.json",
    "typecheck:prepare": "tsc --noEmit -p scripts/tsconfig.prepare.json",
    "typecheck:constants": "tsc -p frontend/constants/tsconfig.json --noEmit",
    "typecheck:hooks": "tsc -p frontend/hooks/tsconfig.json --noEmit",
    "typecheck:utils": "tsc -p frontend/utils/tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p frontend/ui/tsconfig.json --noEmit",
    "typecheck:chimera": "pnpm --filter=chimera-ui generate:i18n && tsc -p frontend/chimera/tsconfig.json --noEmit",
    "typecheck:e2e": "pnpm --filter @chimera/tauri-e2e typecheck",
    "verify:quality": "run-s lint typecheck test:changed-parts test:data-slots test:manifest:node test:manifest test:prepare:node test:nightly:node test:updater:nightly:node",
    "fmt": "run-s fmt:oxlint fmt:prettier fmt:backend",
    "fmt:backend": "cargo fmt --manifest-path ./backend/Cargo.toml --package chimera-config --package chimera-core --package chimera-macro --package chimera",
    "fmt:oxlint": "oxlint --fix . --ignore-pattern \"ref/**\"",
    "fmt:prettier": "prettier --write .",
    "knip": "knip",
    "prepare": "husky",
    "prepare:check": "node scripts/src/prepare/check.ts",
    "nixos:check": "bash scripts/nixos-preflight.sh",
    "check:service-runtime": "tsx scripts/check-service-runtime.ts",
    "smoke:tun:windows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/windows-tun-smoke.ps1",
    "lint:frontend-boundaries": "tsx scripts/check-frontend-boundaries.ts",
    "test:hotkeys": "tsx --test frontend/chimera/src/utils/parse-hotkey.test.ts",
    "test:backend": "cargo test --locked --manifest-path ./backend/Cargo.toml --workspace --all-features",
    "check:changed-parts": "node scripts/src/ci/changed-parts.ts",
    "test:changed-parts": "node --test scripts/src/ci/changed-parts_test.ts",
    "test:release-preflight": "deno test --frozen --allow-read --allow-write --allow-run --allow-env --config scripts/deno.jsonc scripts/src/ci/release-preflight_test.ts",
    "test:nightly-build": "pnpm run test:nightly:node && deno test --frozen --allow-read --allow-write --allow-run --allow-env --allow-sys=cpus --config scripts/deno/deno.jsonc scripts/deno/upload-macos-updater_test.ts",
    "test:agent:intent": "tsx --test frontend/chimera/src/features/agent/model/intent-routing.test.ts frontend/chimera/src/features/agent/model/intent-resolution.test.ts",
    "test:profiles:query": "tsx --test frontend/interface/tests/profile-content-query.test.ts frontend/interface/tests/profile-folders.test.ts frontend/interface/tests/profile-folder-mutation.test.ts",
    "test:manifest": "deno test --frozen --allow-read --allow-write --config scripts/deno.jsonc scripts/github-api_test.ts scripts/src/prepare/binaries_test.ts scripts/src/prepare/check_test.ts scripts/src/prepare/chimera-client-alpha_test.ts scripts/src/prepare/download_test.ts scripts/src/prepare/platform_test.ts scripts/src/prepare/progress_test.ts scripts/src/prepare/resources_test.ts scripts/src/prepare/retry_test.ts scripts/src/prepare/versions_test.ts",
    "test:prepare:node": "node --test scripts/src/prepare/node-prepare_test.ts",
    "test:updater-manifest": "tsx --test scripts/updater-manifest.test.ts scripts/github-release.test.ts",
    "publish": "tsx scripts/publish.ts",
    "dev:diff": "run-p -r web:devtools tauri:diff",
    "tauri:diff": "tauri dev -f verge-dev deadlock-detection -c ./backend/tauri/tauri.conf.json",
    "generate:git-info": "tsx scripts/generate-git-info.ts",
    "generate:manifest": "run-p generate:manifest:*",
    "generate:manifest:latest-version": "node scripts/generate-latest-version.ts",
    "test:manifest:node": "node --test scripts/manifest-node_test.ts",
    "typecheck:manifest": "tsc --noEmit -p scripts/tsconfig.manifest.json",
    "generate:data-slots": "node scripts/extract-data-slots.ts",
    "test:data-slots": "node --test scripts/extract-data-slots_test.ts",
    "typecheck:data-slots": "tsc --noEmit -p scripts/tsconfig.data-slots.json",
    "updater": "pnpm --filter @chimera/scripts exec tsx updater.ts",
    "updater:nightly": "node scripts/updater-nightly.ts",
    "test:updater:nightly:node": "node --test scripts/updater-nightly_test.ts",
    "typecheck:updater:nightly": "tsc --noEmit -p scripts/tsconfig.updater-nightly.json",
    "prepare:nightly": "node scripts/prepare-nightly.ts",
    "test:nightly:node": "node --test scripts/prepare-nightly_test.ts",
    "typecheck:nightly": "tsc --noEmit -p scripts/tsconfig.nightly.json",
    "lint:rustfmt": "cargo fmt --manifest-path ./backend/Cargo.toml --package chimera-config --package chimera-core --package chimera-macro --package chimera -- --check",
    "e2e:tauri:build": "run-s web:build e2e:tauri:build:rust",
    "e2e:tauri:build:rust": "cross-env AWS_LC_SYS_PREBUILT_NASM=1 CARGO_TARGET_DIR=backend/target/e2e TAURI_CONFIG={\\\"build\\\":{\\\"devUrl\\\":null}} cargo build --manifest-path ./backend/tauri/Cargo.toml --features e2e",
    "e2e:tauri:test": "pnpm --filter @chimera/tauri-e2e test",
    "e2e:tauri": "run-s e2e:tauri:build e2e:tauri:test"
  },
  "dependencies": {
    "husky": "9.1.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "npm-run-all2": "9.0.4",
    "react-devtools": "7.0.1",
    "oxlint": "1.90.0",
    "prettier": "3.10.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prettier-plugin-toml": "3.0.2",
    "postcss-scss": "4.0.9",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.8.2",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-order": "8.1.2",
    "stylelint-scss": "7.3.0",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "cross-env": "10.1.0",
    "tsx": "4.23.13",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "prettier-plugin-ember-template-tag": "2.1.8"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "v24.21.0"
  }
}

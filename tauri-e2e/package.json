{
  "name": "@chimera/tauri-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "pnpm run test:smoke",
    "test:unit": "node --test ./subscription-onboarding-cleanup.test.ts ./agent-issue-guidance.test.ts ./clash-runtime.test.ts ./profile-definition.test.ts ./process-cleanup.test.ts ./privacy-safe-context.test.ts ./privacy-safe-error.test.ts ./runtime-path.test.ts ./spec-suites.test.ts ./system-lifecycle-preflight.test.ts",
    "test:upgrade:v0.22.3": "node ./upgrade-v0223-v0230.ts",
    "test:desktop": "pnpm run test:smoke",
    "test:smoke": "wdio run ./wdio.conf.ts --suite smoke",
    "test:critical": "wdio run ./wdio.conf.ts --suite critical && wdio run ./wdio.conf.ts --suite subscription-onboarding",
    "test:runtime": "wdio run ./wdio.conf.ts --suite runtime",
    "test:profiles": "wdio run ./wdio.conf.ts --suite profiles && wdio run ./wdio.conf.ts --suite subscription-onboarding",
    "test:subscription-onboarding": "wdio run ./wdio.conf.ts --suite subscription-onboarding",
    "test:profile-auto-update": "wdio run ./wdio.conf.ts --suite profile-auto-update-main",
    "test:settings": "wdio run ./wdio.conf.ts --suite settings",
    "test:agent": "wdio run ./wdio.conf.ts --suite agent",
    "test:main": "wdio run ./wdio.conf.ts --suite main",
    "test:network": "wdio run ./wdio.conf.ts --suite network",
    "test:system": "wdio run ./wdio.conf.ts --suite system",
    "test:hermetic": "wdio run ./wdio.conf.ts --suite hermetic && wdio run ./wdio.conf.ts --suite subscription-onboarding",
    "test:all": "wdio run ./wdio.conf.ts --suite all && wdio run ./wdio.conf.ts --suite subscription-onboarding && wdio run ./wdio.conf.ts --suite profile-auto-update-main",
    "test:lan": "pnpm run test:network",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.4.0",
    "typescript": "7.0.2",
    "webdriverio": "9.32.0"
  }
}
